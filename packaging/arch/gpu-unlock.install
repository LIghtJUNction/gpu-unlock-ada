post_install() {
  cat <<'EOF'
==> The experimental module is installed without adding it to normal images.
==> Build a separate image with:
==>   mkinitcpio -c /usr/share/doc/gpu-unlock/mkinitcpio-experimental.conf ...
==> Keep a normal boot entry. Opt in only in the experimental entry with:
==>   gpu_unlock.targets=YOUR-PCI-ADDRESS gpu_unlock.ad107_experimental=1
==> See /usr/share/doc/gpu-unlock/docs/lightjunction-28a0.md.
EOF
}
